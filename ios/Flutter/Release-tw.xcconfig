// =====================================
// TW Flavor - Release Configuration
// =====================================

// 继承 Flutter 默认 Release 设置（⚠️ 不要删）
#include "Release.xcconfig"

// Bundle ID（台湾版 - Release）
PRODUCT_BUNDLE_IDENTIFIER = com.sunriseinc.target_notebook.tw

// App 显示名（桌面图标名）
APP_DISPLAY_NAME = Target Notebook TW

// 可选：原生侧 Flavor 标识
FLAVOR = TW

#include "Pods/Target Support Files/Pods-Runner/Pods-Runner.release-tw.xcconfig"
