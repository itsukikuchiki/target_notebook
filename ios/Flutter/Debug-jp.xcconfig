// =====================================
// JP Flavor - Debug Configuration
// =====================================

// 继承 Flutter 默认 Debug 设置（⚠️ 不要删）
#include "Debug.xcconfig"

// Bundle ID（日本版 - Debug）
PRODUCT_BUNDLE_IDENTIFIER = com.sunriseinc.target_notebook.jp

// App 显示名（桌面图标名）
APP_DISPLAY_NAME = Target Notebook JP

// 可选：原生侧 Flavor 标识
FLAVOR = JP

#include "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug-jp.xcconfig"
